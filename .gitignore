# Tyrian3D: data/ holds the game's data (downloaded: tools/fetch_data.sh) and what was made from it.
# What the game and its build need is in the repository: the HD art, the voices, the remastered
# sound effects, the default SoundFont and episode 7's levels. The rest is made again by the tools,
# or is in the devtools release (tools/fetch_devtools.sh).
/data/*
!/data/hd/
!/data/voices/
/data/voices/cache/
/data/voices/previews/
!/data/tyrian2000/
/data/tyrian2000/*
!/data/tyrian2000/sfx/
!/data/soundfonts/
/data/soundfonts/*
!/data/soundfonts/GeneralUser-GS.sf2
!/data/soundfonts/GeneralUser-GS-LICENSE.txt
!/data/gbc/
/data/gbc/*
!/data/gbc/episode7/
/data/gbc/episode7/preview/
!/data/gbc/shop.json
.DS_Store

opentyrian.cfg
tyrian.cfg
tyrian.sav

# Text editor detritus
*~
*.swp

# Make build output
/obj/
/src/*.gch
/opentyrian
/opentyrian2000

# Windows build output
/opentyrian.exe
/SDL2.dll
/SDL2_net.dll

# Windows runtime output
/stderr.txt
/stdout.txt

# MSVC build output and project
/opentyrian-*.exe
/opentyrian-*.ilk
/opentyrian-*.pdb
/opentyrian-*.iobj
/opentyrian-*.ipdb
/visualc/.vs/
/visualc/*.props
/visualc/*.user

# Doxygen output
/doc/doxygen/

# CMake build output
/build/
__pycache__/

# Sprite atlases for upscaling (tools/make_atlases.py), made from the game data
/upscale/

# Exports made from the game data (TYR3D_EXPORT_MUSIC, ...)
/export/

# Tyrian3D: generated from the game data (tools/content/episode6/build.py at build time)
/assets/content/episode6/
# ... and from episode 7's levels, data/gbc/episode7 (tools/content/gbc/build.py)
/assets/content/episode7/

# ElevenLabs API key (npx @elevenlabs/cli onboard connect writes it here; never commit it)
.env.local
